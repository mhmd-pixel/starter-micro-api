<resources>
    <style name="Theme.Optoflow" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <style name="Theme.Optoflow.Starting" parent="Theme.SplashScreen">
